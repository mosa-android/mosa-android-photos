<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_main"
    app:startDestination="@id/mainFragment">

    <fragment
        android:id="@+id/mainFragment"
        android:name="org.mosa.android.photos.fragments.MainFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_main">

        <action
            android:id="@+id/action_mainFragment_to_fragment_album"
            app:destination="@id/fragment_album"
            app:enterAnim="@anim/navigation_enter_anim"
            app:exitAnim="@anim/navigation_exit_anim"
            app:popEnterAnim="@anim/navigation_pop_enter_anim"
            app:popExitAnim="@anim/navigation_pop_exit_anim" />

    </fragment>

</navigation>
