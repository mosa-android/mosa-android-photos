<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_albums"
    app:startDestination="@id/albumsFragment">

    <fragment
        android:id="@+id/albumsFragment"
        android:name="org.mosa.android.photos.fragments.AlbumsFragment"
        android:label="@string/albums_title"
        tools:layout="@layout/fragment_albums">

        <action
            android:id="@+id/action_albumsFragment_to_fragment_album"
            app:destination="@id/fragment_album"
            app:enterAnim="@anim/navigation_enter_anim"
            app:exitAnim="@anim/navigation_exit_anim"
            app:popEnterAnim="@anim/navigation_pop_enter_anim"
            app:popExitAnim="@anim/navigation_pop_exit_anim" />

    </fragment>

</navigation>
